# ============================================
# 周报Pro - .gitignore 配置
# 保护敏感信息和项目整洁性
# ============================================

# ---------- 🚨 敏感信息（最高优先级）----------

# API Key 和密钥配置文件
# ⚠️ 重要：包含 API Key 的文件绝对不能提交！
cloudfunctions/apiProxy/config.js
cloudfunctions/*/config.local.js
*.env
*.env.local
*.env.production
.env.*

# 包含 API Key 的备份文件
*apiKey*.js.bak
*secret*.js
*credential*.*


# ---------- 📦 依赖包 ----------

# Node.js 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# 微信云函数依赖
cloudfunctions/**/node_modules/


# ---------- 💻 IDE / 编辑器配置 ----------

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# WebStorm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.DS_Store


# ---------- 📂 微信小程序特定 ----------

# 开发者工具临时文件
project.private.config.json
miniprogram_npm/

# 编译输出
dist/
build/
.output/

# 缓存文件
.cache/
.temp/
*.tmp
*.temp

# 微信开发者工具日志
*.log
logs/


# ---------- 🔒 系统文件 ----------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# 临时文件
*.swp
*.swo
*~


# ---------- 📊 测试和覆盖率 ----------

coverage/
.nyc_output/
*.cover
.pyc
__pycache__/


# ---------- 🎯 其他 ----------

# 文档草稿
docs/draft/
TODO.md
CHANGELOG.md.tmp

# 大文件（>10MB）
*.zip
*.tar.gz
*.rar
*.7z

# 备份文件
*.bak
*.backup
*.orig

# 调试文件
debug.log
error.log
access.log
