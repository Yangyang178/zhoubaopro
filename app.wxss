/**app.wxss**/

/* ==================== 全局主题变量 ==================== */
page {
  /* 字体系统 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  
  /* 渲染优化 */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;

  /* 基础样式 */
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.6;
  
  /* 背景与布局 */
  background-color: #f8f9ff;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 主题色系统 ==================== */

/* 主色调（紫色渐变系） */
.theme-primary {
  color: #667eea;
}

.theme-primary-light {
  color: #818cf8;
}

.theme-primary-dark {
  color: #5a67d8;
}

/* 背景色 */
.bg-primary {
  background-color: #667eea;
}

.bg-primary-light {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.bg-secondary {
  background-color: #f7fafc;
}

.bg-white {
  background-color: #ffffff;
}

/* ==================== 文字工具类 ==================== */

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }
.font-normal { font-weight: 400; }

.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 44rpx; }

.text-primary { color: #2d3748; }
.text-secondary { color: #718096; }
.text-muted { color: #a0aec0; }
.text-success { color: #48bb78; }
.text-warning { color: #ed8936; }
.text-error { color: #f56565; }
.text-white { color: #ffffff; }

/* ==================== 布局工具类 ==================== */

.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }

.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }

.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-end { justify-content: flex-end; }

.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }

/* 间距 */
.gap-xs { gap: 10rpx; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
.gap-lg { gap: 32rpx; }
.gap-xl { gap: 40rpx; }

.p-xs { padding: 10rpx; }
.p-sm { padding: 16rpx; }
.p-md { padding: 24rpx; }
.p-lg { padding: 32rpx; }
.p-xl { padding: 40rpx; }

.mt-xs { margin-top: 10rpx; }
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 32rpx; }
.mt-xl { margin-top: 40rpx; }

.mb-xs { margin-bottom: 10rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 32rpx; }
.mb-xl { margin-bottom: 40rpx; }

/* ==================== 组件基础样式 ==================== */

/* 卡片容器 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 按钮基础样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

/* 次按钮 */
.btn-secondary {
  background: #ffffff;
  color: #667eea;
  border: 2rpx solid #667eea;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.15);
}

/* 危险按钮 */
.btn-danger {
  background: #ffffff;
  color: #f56565;
  border: 2rpx solid #feb2b2;
}

/* 输入框基础样式 */
.input-base {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #2d3748;
  background: #fafbfc;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.input-base:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
  background: #ffffff;
  outline: none;
}

/* 标签/徽章 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tag-primary {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
  color: #667eea;
}

.tag-success {
  background: rgba(72, 187, 120, 0.1);
  color: #48bb78;
}

.tag-warning {
  background: rgba(237, 137, 54, 0.1);
  color: #ed8936;
}

/* ==================== 动画效果 ==================== */

/* 淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

/* 从下方滑入 */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 脉冲呼吸效果 */
@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.4);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(102, 126, 234, 0);
  }
}

.animate-pulse {
  animation: pulse 2s infinite;
}

/* ==================== 安全区域适配 ==================== */

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

/* ==================== 隐藏滚动条（可选）==================== */

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
