/* profile.wxss - 个人中心页面样式 */

page {
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.profile-container {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 未登录状态 ==================== */
.login-section {
  padding: 120rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
}

.avatar-placeholder {
  font-size: 80rpx;
}

.login-info {
  text-align: center;
  margin-bottom: 48rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 12rpx;
  display: block;
}

.login-desc {
  font-size: 28rpx;
  color: #718096;
  display: block;
}

/* ==================== 微信一键登录按钮（专用） ==================== */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ae56 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.35);
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
  border: none;
  padding: 0;
  line-height: normal;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn-hover {
  transform: scale(0.98);
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.25);
  opacity: 0.9;
}

.wechat-icon-emoji {
  font-size: 40rpx;
}

.wechat-login-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.login-tips {
  text-align: center;
  margin-bottom: 28rpx;
}

.login-tips .tips-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
  display: block;
}

.login-features {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.feature-icon {
  font-size: 28rpx;
  color: #48bb78;
}

.feature-text {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.5;
}

/* ==================== 加载中 ==================== */
.loading-section {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: transparent;
}

.loading-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ==================== 已登录状态 ==================== */
.user-section {
  padding: 0 24rpx 40rpx;
  padding-top: 20rpx;
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.card-bg {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

/* 头像容器（可点击） */
.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-avatar.placeholder {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-avatar.placeholder text {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 头像编辑提示（无头像时） */
.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.avatar-edit-hint .edit-icon {
  font-size: 20rpx;
}

/* 头像编辑徽章（有头像时） */
.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
}

.avatar-edit-badge .badge-text {
  font-size: 18rpx;
}

.user-basic {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 昵称行（包含昵称和编辑图标） */
.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a202c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

/* 编辑笔图标 */
.edit-pen {
  font-size: 28rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

/* 完善资料提示文字 */
.edit-hint {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
  margin-top: 4rpx;
  display: block;
}

.member-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
  border: 2rpx solid #e2e8f0;
}

.member-badge.active {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-color: #f59e0b;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #718096;
}

.member-badge.active .badge-text {
  color: #92400e;
}

.settings-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
}

.settings-btn::after {
  border: none;
}

.settings-icon {
  font-size: 32rpx;
  color: #718096;
  font-weight: bold;
}

/* 数据统计行 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
  border-radius: 20rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #667eea;
}

.stat-label {
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e2e8f0;
}

/* 今日使用情况 */
.usage-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.usage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.usage-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a202c;
}

.usage-detail {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 700;
}

.progress-bar {
  height: 16rpx;
  background: #e2e8f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.usage-tips {
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #e53e3e;
  font-weight: 500;
  display: block;
}

.tips-text.success {
  color: #38a169;
}

/* 功能列表 */
.features-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-more {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.25s ease;
}

.feature-card:active {
  transform: scale(0.98);
  background: #f7fafc;
}

.feature-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon {
  font-size: 40rpx;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a202c;
}

.feature-desc {
  font-size: 24rpx;
  color: #718096;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-arrow {
  font-size: 36rpx;
  color: #cbd5e0;
  font-weight: 300;
  flex-shrink: 0;
}

/* 成就徽章 */
.achievements-section {
  margin-bottom: 24rpx;
}

.achievements-scroll {
  white-space: nowrap;
  margin-top: 16rpx;
}

.achievements-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 24rpx;
}

.achievement-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 2rpx solid #fcd34d;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.achievement-icon {
  font-size: 44rpx;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.version-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.version-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
}
