<!--profile.wxml-->
<navigation-bar title="个人中心" back="{{true}}" color="white" background="#667eea"></navigation-bar>
<scroll-view class="profile-container" scroll-y enhanced show-scrollbar="{{false}}">
  
  <!-- 未登录状态 -->
  <view class="login-section" wx:if="{{!isLoggedIn && !isLoading}}">
    <view class="login-card">
      <view class="login-avatar">
        <text class="avatar-placeholder">👤</text>
      </view>
      
      <view class="login-info">
        <text class="login-title">欢迎使用周报Pro</text>
        <text class="login-desc">一键登录，即刻体验</text>
      </view>
      
      <!-- 微信一键登录按钮 -->
      <button 
        class="wechat-login-btn" 
        bindtap="handleLogin"
        hover-class="wechat-login-btn-hover"
      >
        <text class="wechat-icon-emoji">💚</text>
        <text class="wechat-login-text">微信一键登录</text>
      </button>
      
      <view class="login-tips">
        <text class="tips-text">🔒 安全登录 · 无需授权 · 即点即用</text>
      </view>
      
      <view class="login-features">
        <view class="feature-item">
          <text class="feature-icon">✅</text>
          <text class="feature-text">每日免费生成5次</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">✅</text>
          <text class="feature-text">云端数据自动同步</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">✅</text>
          <text class="feature-text">多设备无缝切换</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-section" wx:if="{{isLoading}}">
    <text class="loading-text">⏳ 加载中...</text>
  </view>

  <!-- 已登录状态 -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <!-- 背景装饰 -->
      <view class="card-bg"></view>
      
      <!-- 用户头像和基本信息（可编辑） -->
      <view class="user-header">
        <!-- 头像 - 可点击更换 -->
        <view class="avatar-wrapper" bindtap="chooseAvatar">
          <image 
            class="user-avatar" 
            src="{{userInfo.avatarUrl}}" 
            mode="aspectFill"
            wx:if="{{userInfo.avatarUrl}}"
          ></image>
          <view class="user-avatar placeholder" wx:else>
            <text>{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</text>
          </view>
          
          <!-- 头像编辑提示 -->
          <view class="avatar-edit-hint" wx:if="{{!userInfo.avatarUrl}}">
            <text class="edit-icon">📷</text>
          </view>
          <view class="avatar-edit-badge" wx:else>
            <text class="badge-text">✏️</text>
          </view>
        </view>
        
        <!-- 昵称和会员信息 - 可编辑 -->
        <view class="user-basic" bindtap="editNickname">
          <view class="nickname-row">
            <text class="user-nickname">{{userInfo.nickname || '微信用户'}}</text>
            <text class="edit-pen">✏️</text>
          </view>
          <view class="member-badge {{membership.isMember ? 'active' : ''}}">
            <text class="badge-text">{{membership.typeText}}</text>
          </view>
          
          <!-- 编辑提示文字 -->
          <text class="edit-hint" wx:if="{{!userInfo.avatarUrl || userInfo.nickname === '微信用户'}}">
            点击完善资料 →
          </text>
        </view>
        
        <!-- 设置按钮 -->
        <button class="settings-btn" bindtap="handleLogout" hover-class="none">
          <text class="settings-icon">⋮⋮</text>
        </button>
      </view>
      
      <!-- 数据统计 -->
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-number">{{formattedStats.cards[0].value || 0}}</text>
          <text class="stat-label">{{formattedStats.cards[0].title}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-number">{{formattedStats.cards[1].value || '0h'}}</text>
          <text class="stat-label">{{formattedStats.cards[1].title}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-number">{{usage.remainingCount === Infinity ? '∞' : usage.remainingCount}}</text>
          <text class="stat-label">今日剩余</text>
        </view>
      </view>
    </view>

    <!-- 📊 数据统计与分析面板（新增） -->
    <view class="analytics-panel" wx:if="{{isLoggedIn}}">

      <!-- ✨ 效率评分卡片（全新设计） -->
      <view class="efficiency-card-premium">
        <view class="efficiency-bg-animation"></view>
        <view class="efficiency-content">
          <view class="efficiency-header-premium">
            <view class="header-left">
              <text class="efficiency-icon">🎯</text>
              <view class="header-text">
                <text class="efficiency-title-premium">工作效率评分</text>
                <text class="efficiency-subtitle">基于你的使用数据智能分析</text>
              </view>
            </view>
          </view>

          <view class="score-display">
            <view class="score-circle-premium {{formattedStats.efficiencyScore >= 80 ? 'excellent' : (formattedStats.efficiencyScore >= 60 ? 'good' : 'normal')}}">
              <view class="score-ring">
                <view class="score-inner">
                  <text class="score-number-premium">{{formattedStats.efficiencyScore || 0}}</text>
                  <text class="score-unit-premium">分</text>
                </view>
              </view>
              <view class="score-glow"></view>
            </view>
            <view class="score-badge">
              <text class="badge-text-premium" wx:if="{{formattedStats.efficiencyScore >= 80}}">🌟 效率超人</text>
              <text class="badge-text-premium" wx:elif="{{formattedStats.efficiencyScore >= 60}}">👍 表现良好</text>
              <text class="badge-text-premium" wx:else>💪 继续加油</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 🎴 核心指标网格（升级版） -->
      <view class="metrics-grid-premium">
        <view
          class="metric-card-premium"
          wx:for="{{formattedStats.cards}}"
          wx:key="title"
          style="--card-color: {{item.color}};"
        >
          <view class="metric-card-bg" style="background: {{item.color}}08;"></view>
          <view class="metric-icon-premium" style="background: linear-gradient(135deg, {{item.color}}20 0%, {{item.color}}40 100%);">
            <text class="metric-emoji">{{item.icon}}</text>
          </view>
          <view class="metric-data">
            <text class="metric-value-premium" style="color: {{item.color}};">{{item.value}}{{item.unit}}</text>
            <text class="metric-label-premium">{{item.title}}</text>
          </view>
          <view class="metric-trend-badge {{item.trend || 'neutral'}}" wx:if="{{item.trend}}">
            <text class="trend-icon-premium">{{item.trend === 'up' ? '↑' : '↓'}}</text>
          </view>
        </view>
      </view>

      <!-- 📈 本周趋势图表（精美版） -->
      <view class="trend-section-premium">
        <view class="section-header-premium">
          <view class="title-group">
            <text class="section-icon-premium">📈</text>
            <text class="section-title-premium">本周生成趋势</text>
          </view>
          <text class="section-tag">近7天</text>
        </view>

        <view class="chart-container-premium">
          <view class="chart-bars-premium">
            <view
              class="bar-wrapper-premium"
              wx:for="{{formattedStats.weeklyTrend}}"
              wx:key="day"
            >
              <view class="bar-info">
                <text class="bar-count-premium" wx:if="{{item.count > 0}}">{{item.count}}</text>
              </view>
              <view class="bar-container">
                <view
                  class="bar-fill-premium {{item.isToday ? 'today' : ''}}"
                  style="height: {{item.count > 0 ? (item.count * 25) : 4}}rpx;"
                >
                  <view class="bar-shine" wx:if="{{item.count > 0}}"></view>
                </view>
              </view>
              <text class="bar-day-premium {{item.isToday ? 'active' : ''}}">{{item.day.slice(-1)}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 岗位分布（保持原有，如有数据才显示） -->
      <view class="distribution-section-premium" wx:if="{{formattedStats.positionDistribution.length > 0}}">
        <view class="section-header-premium">
          <view class="title-group">
            <text class="section-icon-premium">💼</text>
            <text class="section-title-premium">岗位使用分布</text>
          </view>
        </view>

        <view class="distribution-list-premium">
          <view
            class="dist-item-premium"
            wx:for="{{formattedStats.positionDistribution}}"
            wx:key="name"
          >
            <view class="dist-header-premium">
              <text class="dist-name-premium">{{item.name}}</text>
              <text class="dist-percent-premium">{{item.percentage}}%</text>
            </view>
            <view class="dist-bar-container">
              <view
                class="dist-bar-fill-premium"
                style="width: {{item.percentage}}%;"
              ></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 高峰时段（保持原有，如有数据才显示） -->
      <view class="peak-hours-section-premium" wx:if="{{formattedStats.peakHours.length > 0}}">
        <view class="section-header-premium">
          <view class="title-group">
            <text class="section-icon-premium">⏰</text>
            <text class="section-title-premium">高峰活跃时段</text>
          </view>
        </view>

        <view class="peak-list-premium">
          <view
            class="peak-item-premium"
            wx:for="{{formattedStats.peakHours}}"
            wx:key="hour"
          >
            <view class="peak-rank-premium {{index === 0 ? 'gold' : (index === 1 ? 'silver' : 'bronze')}}">
              <text class="rank-text">{{index + 1}}</text>
            </view>
            <view class="peak-info-premium">
              <text class="peak-time-premium">{{item.label}}</text>
              <text class="peak-desc-premium">最活跃时段</text>
            </view>
            <text class="peak-count-premium">{{item.count}}次</text>
          </view>
        </view>
      </view>

      <!-- 🎁 月度报告入口卡片（豪华版） -->
      <view class="monthly-report-premium" bindtap="generateMonthlyReport">
        <view class="monthly-bg-pattern"></view>
        <view class="monthly-content">
          <view class="monthly-left-premium">
            <view class="monthly-icon-wrapper">
              <text class="monthly-icon-premium">📊</text>
            </view>
            <view class="monthly-text-group">
              <text class="monthly-title-premium">本月工作报告</text>
              <text class="monthly-desc-premium">点击生成专属月度总结 · 智能分析</text>
            </view>
          </view>
          <view class="monthly-right-premium">
            <text class="monthly-action">生成</text>
            <text class="monthly-arrow-premium">→</text>
          </view>
        </view>
        <view class="monthly-shine"></view>
      </view>

    </view>

    <!-- 今日使用情况 -->
    <view class="usage-card">
      <view class="usage-header">
        <text class="usage-title">📊 今日使用情况</text>
        <text class="usage-detail">{{usage.dailyCount || 0}}/{{usage.dailyLimit}} 次</text>
      </view>
      
      <view class="progress-bar">
        <view 
          class="progress-fill" 
          style="width: {{(usage.dailyCount / usage.dailyLimit * 100) > 100 ? 100 : (usage.dailyCount / usage.dailyLimit * 100)}}%"
        ></view>
      </view>
      
      <view class="usage-tips">
        <text class="tips-text" wx:if="{{!membership.isMember && usage.remainingCount <= 1}}">
          ⚠️ 次数不足？升级 Pro 会员享无限次
        </text>
        <text class="tips-text success" wx:elif="{{membership.isMember}}">
          ✨ Pro 会员：今日无限次
        </text>
        <text class="tips-text" wx:else>
          💪 继续加油！还剩 {{usage.remainingCount}} 次
        </text>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="features-section">
      <view class="section-header">
        <text class="section-title">我的服务</text>
      </view>
      
      <view class="features-list">
        <view 
          class="feature-card" 
          wx:for="{{featureList}}" 
          wx:key="title"
          data-page="{{item.page}}"
          data-action="{{item.action}}"
          data-show="{{item.show}}"
          bindtap="navigateToFeature"
        >
          <view class="feature-icon-wrap">
            <text class="feature-icon">{{item.icon}}</text>
          </view>
          
          <view class="feature-content">
            <text class="feature-title">{{item.title}}</text>
            <text class="feature-desc">{{item.desc}}</text>
          </view>
          
          <text class="feature-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 成就徽章（简化版） -->
    <view class="achievements-section" wx:if="{{stats.achievements.length > 0}}">
      <view class="section-header">
        <text class="section-title">🏆 我的成就</text>
        <text class="section-more">查看全部 ›</text>
      </view>
      
      <scroll-view scroll-x class="achievements-scroll" enhanced show-scrollbar="{{false}}">
        <view class="achievements-list">
          <view 
            class="achievement-item" 
            wx:for="{{stats.achievements}}" 
            wx:key="*this"
          >
            <text class="achievement-icon">{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 版本信息 -->
    <view class="version-info">
      <text class="version-text">周报Pro v1.0.0</text>
      <text class="version-desc">让AI帮你写周报，告别加班 ✨</text>
    </view>
  </view>

</scroll-view>
