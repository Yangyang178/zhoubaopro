<!--index.wxml-->
<navigation-bar title="周报Pro" back="{{false}}" color="white" background="#667eea"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">

    <!-- 头部区域 -->
    <view class="header">
      <text class="header-title">💡 报报pro</text>
      <text class="header-subtitle">AI帮你30秒生成周报</text>
    </view>

    <!-- 岗位选择区域 -->
    <view class="section position-section">
      <text class="section-title">📌 你的岗位</text>
      <view class="position-tags">
        <view
          wx:for="{{positions}}"
          wx:key="id"
          class="position-tag {{selectedPosition === item.id ? 'active' : ''}}"
          bindtap="selectPosition"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <!-- 本周工作输入区 -->
    <view class="section work-section">
      <text class="section-title">📋 本周工作</text>
      <view class="textarea-wrapper">
        <textarea
          class="textarea-large"
          placeholder="例如：完成了登录模块开发，修复了3个bug..."
          maxlength="1000"
          auto-height
          value="{{weeklyWork}}"
          bindinput="onWorkInput"
          placeholder-class="placeholder-text"
        ></textarea>
        
        <!-- 操作栏：字数统计 + 清除按钮 -->
        <view class="textarea-actions">
          <text class="char-count">{{weeklyWork.length}}/1000</text>
          <view 
            class="clear-btn {{weeklyWork ? 'visible' : ''}}" 
            wx:if="{{weeklyWork}}"
            bindtap="clearWeeklyWork"
          >
            <text class="clear-btn-text">🗑️ 清除</text>
          </view>
        </view>
      </view>
      
      <!-- 模板快捷入口 -->
      <view class="template-trigger" bindtap="toggleTemplatePicker">
        <text class="template-icon">💡</text>
        <text class="template-text">使用工作模板</text>
      </view>

      <!-- 工作模板选择器 -->
      <view class="template-picker" wx:if="{{showTemplatePicker}}">
        <view class="template-header">
          <text class="template-title">选择工作内容模板</text>
          <text class="template-close" bindtap="toggleTemplatePicker">✕</text>
        </view>
        <scroll-view scroll-y class="template-list">
          <view 
            class="template-item" 
            wx:for="{{workTemplates}}" 
            wx:key="*this"
            bindtap="selectTemplate"
            data-index="{{index}}"
          >
            <text class="template-item-text">{{item}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 下周计划输入区 -->
    <view class="section plan-section">
      <text class="section-title">📅 下周计划</text>
      <view class="textarea-wrapper">
        <textarea
          class="textarea-medium"
          placeholder="例如：开始订单系统开发..."
          maxlength="500"
          auto-height
          value="{{nextPlan}}"
          bindinput="onPlanInput"
          placeholder-class="placeholder-text"
        ></textarea>
        
        <!-- 操作栏：字数统计 + 清除按钮 -->
        <view class="textarea-actions">
          <text class="char-count">{{nextPlan.length}}/500</text>
          <view 
            class="clear-btn {{nextPlan ? 'visible' : ''}}" 
            wx:if="{{nextPlan}}"
            bindtap="clearNextPlan"
          >
            <text class="clear-btn-text">🗑️ 清除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 问题与困难输入区 -->
    <view class="section problem-section">
      <text class="section-title">⚠️ 问题与困难</text>
      <view class="textarea-wrapper">
        <textarea
          class="textarea-medium"
          placeholder="遇到的困难，没有可填无"
          maxlength="500"
          auto-height
          value="{{problems}}"
          bindinput="onProblemInput"
          placeholder-class="placeholder-text"
        ></textarea>
        
        <!-- 操作栏：字数统计 + 清除按钮 -->
        <view class="textarea-actions">
          <text class="char-count">{{problems.length}}/500</text>
          <view 
            class="clear-btn {{problems ? 'visible' : ''}}" 
            wx:if="{{problems}}"
            bindtap="clearProblems"
          >
            <text class="clear-btn-text">🗑️ 清除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 撤销提示条（清除后显示） -->
    <view class="undo-toast {{showUndoToast ? 'visible' : ''}}" wx:if="{{showUndoToast}}">
      <text class="undo-text">已清除内容</text>
      <view class="undo-btn" bindtap="undoClear">
        <text class="undo-btn-text">↩️ 撤销 ({{undoCountdown}}s)</text>
      </view>
    </view>

    <!-- 精美按钮组区域 -->
    <view class="action-buttons-section">

      <!-- 每日使用次数提示 -->
      <view class="usage-tip-bar" wx:if="{{!isMember}}">
        <view class="usage-info">
          <text class="usage-icon">⚡</text>
          <text class="usage-text">今日剩余：{{remainingCount}}/{{dailyLimit}} 次</text>
        </view>
        <view class="usage-progress">
          <view
            class="usage-progress-fill"
            style="width: {{(usedCount / dailyLimit) * 100}}%"
          ></view>
        </view>
      </view>

      <!-- 主操作按钮：生成周报 -->
      <button
        class="action-btn primary-btn {{isGenerating ? 'generating' : ''}}"
        bindtap="generateReport"
        disabled="{{isGenerating}}"
      >
        <view class="btn-content">
          <text class="btn-icon">{{isGenerating ? '⏳' : '✨'}}</text>
          <text class="btn-text">{{isGenerating ? 'AI智能生成中...' : '生成专业周报'}}</text>
        </view>
      </button>

      <!-- 生成进度步骤（生成中显示） -->
      <view class="progress-steps" wx:if="{{isGenerating}}">
        <view 
          class="step-item {{item.status}}" 
          wx:for="{{generatingSteps}}" 
          wx:key="text"
        >
          <view class="step-icon">{{item.icon}}</view>
          <text class="step-text">{{item.text}}</text>
          <view class="step-indicator" wx:if="{{item.status === 'active'}}"></view>
        </view>
      </view>

      <!-- 次要操作按钮组 -->
      <view class="secondary-actions">
        <button class="action-btn secondary-btn" bindtap="clearAll">
          <view class="btn-content">
            <text class="btn-icon">�</text>
            <text class="btn-text">清除重置</text>
          </view>
        </button>
        
        <button 
          class="action-btn history-btn-new" 
          bindtap="goToHistory"
        >
          <view class="btn-content">
            <text class="btn-icon">📚</text>
            <text class="btn-text">历史记录</text>
            <view class="badge" wx:if="{{historyCount > 0}}">
              <text class="badge-text">{{historyCount > 99 ? '99+' : historyCount}}</text>
            </view>
          </view>
        </button>
      </view>

    </view>

    <!-- 生成结果展示区 -->
    <view class="result-section" wx:if="{{showResult}}">
      <view class="result-header">
        <view class="result-title-wrapper">
          <text class="result-icon">🎉</text>
          <text class="result-title">生成成功</text>
        </view>
        <view class="result-header-actions">
          <text class="word-count">{{generatedReport.length}} 字</text>
          <text class="copy-btn" bindtap="copyReport">📋 复制</text>
        </view>
      </view>
      
      <view class="result-card">
        <text 
          class="result-content {{!showFullContent ? 'collapsed' : ''}}" 
          wx:if="{{!showFullContent && generatedReport.length > 200}}"
        >
          {{generatedReport.substring(0, 200)}}...
        </text>
        <text 
          class="result-content" 
          wx:if="{{showFullContent || generatedReport.length <= 200}}"
        >
          {{generatedReport}}
        </text>
        
        <!-- 展开/收起按钮 -->
        <view 
          class="expand-btn" 
          wx:if="{{generatedReport.length > 200}}"
          bindtap="toggleContent"
        >
          <text class="expand-text">{{showFullContent ? '收起内容 ↑' : '展开全部 ↓'}}</text>
        </view>
      </view>

      <view class="result-actions">
        <button class="result-action-btn save-btn-new" bindtap="saveReport">
          <text class="action-icon">💾</text>
          <text>保存到云端</text>
        </button>
        <button class="result-action-btn share-btn-new" open-type="share">
          <text class="action-icon">📤</text>
          <text>分享</text>
        </button>
        <button class="result-action-btn view-history-btn" bindtap="goToHistory">
          <text class="action-icon">�</text>
          <text>查看历史</text>
        </button>
      </view>
    </view>

    <!-- 底部导航栏（无TabBar时的替代方案） -->
    <view class="bottom-nav">
      <view class="nav-item active" bindtap="goToHome">
        <text class="nav-icon">🏠</text>
        <text class="nav-text">首页</text>
        <view class="active-indicator"></view>
      </view>
      
      <view class="nav-item" bindtap="goToHistory">
        <text class="nav-icon">📚</text>
        <text class="nav-text">历史记录</text>
      </view>
      
      <view class="nav-item" bindtap="goToProfile">
        <text class="nav-icon">👤</text>
        <text class="nav-text">个人中心</text>
      </view>
    </view>

  </view>
</scroll-view>
